# Convex Deployment (from `npx convex dev`)
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# BulkSMSGH SMS (key is set as a Convex secret, never in the browser)
BULKSMSGH_API_KEY=
SMS_SENDER_ID=TEIN UCC
SMS_DRY_RUN=true

# Authentication recovery (set a long random value as a Convex secret; do not commit it)
AUTH_RECOVERY_PEPPER=

